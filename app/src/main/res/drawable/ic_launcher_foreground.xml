<?xml version="1.0" encoding="utf-8"?>
<!-- Gold coin with a pulse line. Everything sits inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Soft shadow -->
    <path
        android:fillColor="#40000000"
        android:pathData="M24,56a30,30 0 1,0 60,0a30,30 0 1,0 -60,0z" />
    <!-- Coin edge -->
    <path android:pathData="M24,54a30,30 0 1,0 60,0a30,30 0 1,0 -60,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="78"
                android:endY="82"
                android:startX="30"
                android:startY="26"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFEBA8" />
                <item android:offset="0.5" android:color="#FFE6B34A" />
                <item android:offset="1" android:color="#FF9E6A12" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Bevel -->
    <path android:pathData="M28.5,54a25.5,25.5 0 1,0 51,0a25.5,25.5 0 1,0 -51,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="72"
                android:endY="76"
                android:startX="36"
                android:startY="32"
                android:type="linear">
                <item android:offset="0" android:color="#FFAD7A1E" />
                <item android:offset="1" android:color="#FFF7D77E" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Face -->
    <path android:pathData="M30.5,54a23.5,23.5 0 1,0 47,0a23.5,23.5 0 1,0 -47,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="70"
                android:endY="74"
                android:startX="38"
                android:startY="34"
                android:type="linear">
                <item android:offset="0" android:color="#FFFBE29A" />
                <item android:offset="1" android:color="#FFD9A23C" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Highlight -->
    <path
        android:pathData="M36.6,43.5A20.5,20.5 0 0,1 49.5,34"
        android:strokeWidth="2.2"
        android:strokeAlpha="0.7"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />
    <!-- Pulse -->
    <path
        android:pathData="M34,55H42.5L46.5,45L52.5,66L57.5,48.5L61.5,58L64.5,55H74"
        android:strokeWidth="3.4"
        android:strokeColor="#FF6B4A0E"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
